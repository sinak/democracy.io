{
  "name": "democracy.io",
  "private": true,
  "version": "2.0.0",
  "description": "Democracy.io React frontend and TypeScript backend",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "start": "npm run start --workspace backend"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/l12s/democracy.io.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/l12s/democracy.io/issues"
  },
  "homepage": "https://github.com/l12s/democracy.io",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
